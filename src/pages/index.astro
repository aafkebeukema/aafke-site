---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    name: 'Custom AI automations',
    price: 'from £150 per project',
    body: 'The repetitive parts of running your business, handled. Chasing payments, sorting enquiries into a to-do list, pulling scattered information into one place you can actually read.',
  },
  {
    name: 'Custom websites',
    price: 'from £250 per project',
    body: 'A fast, clean site that works properly on a phone and says what you do. Built to load quickly and be easy to change later, with no template subscription and no page builder lock-in.',
  },
];

const examples = [
  'A dashboard showing which clients have paid this month and which need chasing',
  'Customer WhatsApp messages turned into prioritised tasks, filed against the right client',
  'A website for a joinery and design studio',
  'A watcher that tracks house prices in one neighbourhood',
  'Browser games built for and with my kids',
];
---

<Layout
  title="Aafke Beukema | AI automations and websites"
  description="I build custom AI automations and websites for small businesses. Practical tools that save you time, from £150 per project."
>
  <link
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Newsreader:ital,opsz,wght@0,72,400;0,72,600;1,72,500&display=swap"
    rel="stylesheet"
  />
  <main>
    <header class="masthead">
      <p class="eyebrow">Aafke Beukema</p>
      <h1>I build small tools that give your business back hours every week.</h1>
      <p class="tagline">
        Custom AI automations and websites for people running a business without
        a technical team behind them. Scope and price agreed together, up front.
      </p>
    </header>

    <section aria-labelledby="services">
      <h2 id="services">What I do</h2>
      <div class="services">
        {services.map((service) => (
          <article>
            <h3>{service.name}</h3>
            <p class="price">{service.price}</p>
            <p>{service.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="how-it-works">
      <h2 id="how-it-works">How it works</h2>
      <p class="how-intro">
        Two kinds of project, one way of working. Show me what's already true
        about your business, and I'll take it from there.
      </p>
      <div class="tab-switch" role="tablist" aria-label="Project type">
        <button type="button" id="tab-automations" class="tab-btn active" data-tab="automations" role="tab" aria-controls="panel-automations" aria-selected="true">Automate repetitive tasks</button>
        <button type="button" id="tab-websites" class="tab-btn" data-tab="websites" role="tab" aria-controls="panel-websites" aria-selected="false" tabindex="-1">A beautiful, affordable website</button>
      </div>
    </section>

    <div class="case-bleed">
      <section class="case-panel" id="panel-automations" data-panel="automations" role="tabpanel" aria-labelledby="tab-automations">
        <div class="case-inner">
          <header style="max-width:680px;margin-bottom:56px">
            <h3>A Tuesday at Sunny Days Childminding</h3>
            <p style="font-size:19px;line-height:1.55;color:#6b6b66;margin:0;font-style:italic">Nothing new to learn, nothing for parents to install, same spreadsheet, same group chat. The repetitive part just gets done for you.</p>
          </header>

          <div class="sd-timeline">

            <!-- 7.38am -->
            <div class="sd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:16px;padding-top:14px;text-align:right;color:#1a1a18">7.38am</div>
              <div class="sd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:oklch(0.42 0.14 258);margin-top:18px;z-index:1"></div></div>

              <div style="background:#fdfdfb;border:1px solid oklch(0.85 0.01 90);border-radius:2px;box-shadow:0 2px 10px oklch(0 0 0 / 0.06);overflow:hidden;max-width:420px;font-family:system-ui,sans-serif">
                <div style="background:oklch(0.94 0.005 90);padding:10px 14px;border-bottom:1px solid oklch(0.85 0.01 90);display:flex;align-items:center;gap:10px">
                  <div style="width:30px;height:30px;border-radius:50%;background:oklch(0.75 0.03 200);flex:none"></div>
                  <div>
                    <div style="font-size:13.5px;font-weight:600;color:#333">Clara Childminding</div>
                    <div style="font-size:11px;color:#777">Group · 3 members</div>
                  </div>
                </div>
                <div style="padding:14px;display:flex;flex-direction:column;gap:10px;background:oklch(0.97 0.003 90)">
                  <div style="max-width:82%">
                    <div style="font-size:11px;color:#7a5a9a;font-weight:600;margin-bottom:3px;margin-left:2px">Jo, Clara's mum</div>
                    <div style="background:#fff;border:1px solid oklch(0.88 0.01 90);border-radius:10px 10px 10px 2px;padding:9px 12px;font-size:13.5px;line-height:1.4;color:#222">Hiya! Could we add Thurs &amp; Fri next week for Clara, full days both, if that's ok? 🙏</div>
                    <div style="font-size:10.5px;color:#999;margin-top:2px;margin-left:2px">7:38</div>
                  </div>
                  <div style="max-width:82%;align-self:flex-end">
                    <div style="background:oklch(0.9 0.05 150);border-radius:10px 10px 2px 10px;padding:9px 12px;font-size:13.5px;line-height:1.4;color:#1a2e1a">Course we can, I'll get it booked in now 😊</div>
                    <div style="font-size:10.5px;color:#999;margin-top:2px;text-align:right;margin-right:2px">7:39 ✓✓</div>
                  </div>
                </div>
              </div>

              <div class="sd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:20px;line-height:1.3;color:oklch(0.42 0.14 258);transform:rotate(-1.5deg);padding-top:10px">You screenshot it. That's the whole of your job here.</div>
            </div>

            <!-- 7.39am -->
            <div class="sd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:16px;padding-top:14px;text-align:right;color:#1a1a18">7.39am</div>
              <div class="sd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:oklch(0.42 0.14 258);margin-top:18px;z-index:1"></div></div>

              <div style="background:#fff;border:1px solid oklch(0.85 0.01 90);border-radius:2px;box-shadow:0 2px 10px oklch(0 0 0 / 0.06);overflow:hidden;max-width:460px;font-family:system-ui,sans-serif;font-size:12.5px">
                <div style="display:grid;grid-template-columns:26px 1fr 1fr 1fr 1fr">
                  <div style="background:oklch(0.93 0.003 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2"></div>
                  <div style="background:oklch(0.93 0.003 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;text-align:center;color:#777;padding:3px 0">A</div>
                  <div style="background:oklch(0.93 0.003 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;text-align:center;color:#777;padding:3px 0">B</div>
                  <div style="background:oklch(0.93 0.003 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;text-align:center;color:#777;padding:3px 0">C</div>
                  <div style="background:oklch(0.93 0.003 90);border-bottom:1px solid #d8d8d8;text-align:center;color:#777;padding:3px 0">D</div>

                  <div style="background:oklch(0.9 0.005 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;text-align:center;color:#777;padding:5px 0">1</div>
                  <div style="background:oklch(0.9 0.005 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;font-weight:600;padding:5px 8px;color:#222">Date</div>
                  <div style="background:oklch(0.9 0.005 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;font-weight:600;padding:5px 8px;color:#222">Child</div>
                  <div style="background:oklch(0.9 0.005 90);border-bottom:1px solid #d8d8d8;border-right:1px solid #e2e2e2;font-weight:600;padding:5px 8px;color:#222">Session</div>
                  <div style="background:oklch(0.9 0.005 90);border-bottom:1px solid #d8d8d8;font-weight:600;padding:5px 8px;color:#222">Rate</div>

                  <div style="border-bottom:1px solid #eaeaea;border-right:1px solid #eee;text-align:center;color:#999;padding:5px 0">2</div>
                  <div style="border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Tue 15 Sep</div>
                  <div style="border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Amara</div>
                  <div style="border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Full day</div>
                  <div style="border-bottom:1px solid #eaeaea;padding:5px 8px;color:#444">£58</div>

                  <div style="background:oklch(0.98 0.003 90);border-bottom:1px solid #eaeaea;border-right:1px solid #eee;text-align:center;color:#999;padding:5px 0">3</div>
                  <div style="background:oklch(0.98 0.003 90);border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Thu 17 Sep</div>
                  <div style="background:oklch(0.98 0.003 90);border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Theo</div>
                  <div style="background:oklch(0.98 0.003 90);border-bottom:1px solid #eaeaea;border-right:1px solid #eee;padding:5px 8px;color:#444">Morning</div>
                  <div style="background:oklch(0.98 0.003 90);border-bottom:1px solid #eaeaea;padding:5px 8px;color:#444">£34</div>

                  <div style="background:oklch(0.9 0.11 98);border-bottom:1px solid #eee;border-right:1px solid #e6d98a;text-align:center;color:#8a7300;padding:5px 0;font-weight:600">4</div>
                  <div style="background:oklch(0.9 0.11 98);border-bottom:1px solid #eee;border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Thu 24 Sep</div>
                  <div style="background:oklch(0.9 0.11 98);border-bottom:1px solid #eee;border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Clara</div>
                  <div style="background:oklch(0.9 0.11 98);border-bottom:1px solid #eee;border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Full day</div>
                  <div style="background:oklch(0.9 0.11 98);padding:5px 8px;font-weight:600;color:#3a3200">£62</div>

                  <div style="background:oklch(0.9 0.11 98);border-right:1px solid #e6d98a;text-align:center;color:#8a7300;padding:5px 0;font-weight:600">5</div>
                  <div style="background:oklch(0.9 0.11 98);border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Fri 25 Sep</div>
                  <div style="background:oklch(0.9 0.11 98);border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Clara</div>
                  <div style="background:oklch(0.9 0.11 98);border-right:1px solid #e6d98a;padding:5px 8px;font-weight:600;color:#3a3200">Full day</div>
                  <div style="background:oklch(0.9 0.11 98);padding:5px 8px;font-weight:600;color:#3a3200">£62</div>
                </div>
                <div style="display:flex;gap:1px;background:#d8d8d8;border-top:1px solid #d8d8d8">
                  <div style="background:#fff;padding:6px 14px;font-size:11.5px;font-weight:600;color:#222;border-top:2px solid oklch(0.42 0.14 258)">Bookings</div>
                  <div style="background:oklch(0.92 0.003 90);padding:6px 14px;font-size:11.5px;color:#777">Children</div>
                  <div style="background:oklch(0.92 0.003 90);padding:6px 14px;font-size:11.5px;color:#777">Rates</div>
                </div>
              </div>

              <div class="sd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:20px;line-height:1.3;color:oklch(0.42 0.14 258);transform:rotate(1deg);padding-top:10px">The booking writes itself into your own file.</div>
            </div>

            <!-- 7.40am -->
            <div class="sd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:16px;padding-top:14px;text-align:right;color:#1a1a18">7.40am</div>
              <div class="sd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:oklch(0.42 0.14 258);margin-top:18px;z-index:1"></div></div>

              <div style="background:#fff;border:1px solid oklch(0.85 0.01 90);border-radius:6px;box-shadow:0 4px 16px oklch(0 0 0 / 0.08);padding:18px;max-width:340px;font-family:system-ui,sans-serif">
                <div style="font-size:13px;line-height:1.5;color:#222;margin-bottom:14px">Clara, Thursday 24 &amp; Friday 25 September, full days at £62. Add both?</div>
                <div style="display:flex;flex-direction:column;gap:7px">
                  <button style="background:oklch(0.55 0.1 150);color:#fff;border:none;border-radius:5px;padding:8px 10px;font-size:12.5px;font-weight:600;text-align:left;cursor:default;font-family:system-ui,sans-serif">Yes, add them</button>
                  <button style="background:oklch(0.95 0.003 90);color:#333;border:1px solid #ddd;border-radius:5px;padding:8px 10px;font-size:12.5px;text-align:left;cursor:default;font-family:system-ui,sans-serif">Change something</button>
                  <button style="background:#fff;color:#888;border:1px solid #eee;border-radius:5px;padding:8px 10px;font-size:12.5px;text-align:left;cursor:default;font-family:system-ui,sans-serif">Not a booking</button>
                </div>
              </div>

              <div class="sd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:20px;line-height:1.3;color:oklch(0.42 0.14 258);transform:rotate(-1deg);padding-top:10px">Five seconds. Nothing saves without your say-so.</div>
            </div>

            <!-- 8.15am -->
            <div class="sd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:16px;padding-top:14px;text-align:right;color:#1a1a18">8.15am</div>
              <div class="sd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:oklch(0.42 0.14 258);margin-top:18px;z-index:1"></div></div>

              <div style="background:oklch(0.985 0.002 90);border:1px solid oklch(0.83 0.01 90);border-radius:2px;box-shadow:0 2px 10px oklch(0 0 0 / 0.06);padding:16px 18px;max-width:460px;font-family:system-ui,sans-serif">
                <div style="font-size:15px;font-weight:700;color:#223;margin-bottom:10px;border-bottom:1px solid #ccc;padding-bottom:6px">Thursday 24 September</div>
                <div style="font-size:12.5px;color:#333;margin-bottom:12px"><span style="font-weight:600">Who's in:</span> Amara (18mo), Theo (3), Clara (4)</div>

                <div style="font-size:10.5px;font-weight:600;color:#889;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Meals</div>
                <div style="display:flex;flex-direction:column;gap:5px;font-size:12px;color:#333;margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #e3e3e3">
                  <div><span style="font-weight:600;color:#556">Breakfast,</span> toast and fruit</div>
                  <div><span style="font-weight:600;color:#556">Lunch,</span> chicken pasta bake, sweetcorn</div>
                  <div><span style="font-weight:600;color:#556">Tea,</span> beans on toast, cucumber sticks</div>
                </div>

                <div style="font-size:10.5px;font-weight:600;color:#889;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:5px">Activities &amp; learning</div>
                <div style="display:flex;flex-direction:column;gap:7px;font-size:12px;color:#333">
                  <div><span style="font-weight:600;color:#556">Morning,</span> messy play &amp; playdough <span style="color:#8a8">· Physical development</span></div>
                  <div><span style="font-weight:600;color:#556">After lunch,</span> garden time, bikes and scooters <span style="color:#8a8">· Physical development</span></div>
                  <div><span style="font-weight:600;color:#556">Snack &amp; chat,</span> fruit and milk, talking about the weekend <span style="color:#8a8">· Communication &amp; language</span></div>
                  <div><span style="font-weight:600;color:#556">Three o'clock,</span> story and songs before pick-up <span style="color:#8a8">· Literacy</span></div>
                </div>
              </div>

              <div class="sd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:20px;line-height:1.3;color:oklch(0.42 0.14 258);transform:rotate(1.5deg);padding-top:10px">Thursday's planned before you've had your coffee.</div>
            </div>

            <!-- 5.30pm -->
            <div class="sd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:16px;padding-top:14px;text-align:right;color:#1a1a18">5.30pm</div>
              <div class="sd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:oklch(0.42 0.14 258);margin-top:18px;z-index:1"></div></div>

              <div style="background:#fff;border:1px solid oklch(0.85 0.01 90);border-radius:6px;box-shadow:0 2px 10px oklch(0 0 0 / 0.06);padding:16px 18px;max-width:420px;font-family:system-ui,sans-serif">
                <div style="font-size:13.5px;line-height:1.55;color:#222;margin-bottom:12px">Busy one today! Clara got stuck into messy play and playdough this morning, had chicken pasta bake for lunch, then bikes and scootering in the garden before story time. She's had a good nap too 😊</div>
                <button id="copy-btn" class="sd-copy-btn" data-message="Busy one today! Clara got stuck into messy play and playdough this morning, had chicken pasta bake for lunch, then bikes and scootering in the garden before story time. She's had a good nap too 😊">Copy message</button>
              </div>

              <div class="sd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:20px;line-height:1.3;color:oklch(0.42 0.14 258);transform:rotate(-1.5deg);padding-top:10px">One paste into the group chat. Laptop shut, your day's done.</div>
            </div>

          </div>

          <footer style="max-width:640px;margin-top:24px;border-top:1px solid oklch(0.82 0.01 90);padding-top:28px">
            <p style="font-size:18px;line-height:1.5;color:#1a1a18;margin:0;font-style:italic">A few hours back in your week, every week, and by month end, the invoices have already added themselves up.</p>
          </footer>
        </div>
      </section>

      <section class="case-panel" id="panel-websites" data-panel="websites" role="tabpanel" aria-labelledby="tab-websites" hidden>
        <div class="case-inner">
          <header style="max-width:680px;margin-bottom:48px">
            <h3 style="font-family:'Newsreader',Georgia,serif;font-size:clamp(30px,4vw,42px);line-height:1.15;margin:0 0 18px;font-weight:600">A fortnight with Pencil Design</h3>
            <p style="font-size:19px;line-height:1.55;color:#6b6b66;margin:0;font-style:italic;font-family:'Newsreader',Georgia,serif">No brief to write, no jargon to learn, just your business as it already is, turned into a site that looks like you.</p>
          </header>

          <div>

            <!-- Day 1 -->
            <div class="wd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 1</div>
              <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

              <div>
                <div style="font-weight:600;font-size:14.5px;margin-bottom:12px;color:#1a1a18">You show me what you've got.</div>
                <div class="wd-collage" style="position:relative;height:200px;max-width:440px">
                  <div style="position:absolute;left:0;top:6px;width:190px;background:#fff;border:1px solid #d8d5cd;border-radius:6px;overflow:hidden;transform:rotate(-3deg);box-shadow:0 3px 8px rgba(0,0,0,0.08);font-family:system-ui,sans-serif">
                    <div style="background:#3b5998;color:#fff;font-size:10px;font-weight:700;padding:5px 8px">facebook</div>
                    <div style="height:44px;background:#c9c2b3"></div>
                    <div style="padding:8px">
                      <div style="font-size:11px;font-weight:700;color:#222">Pencil Design</div>
                      <div style="font-size:9.5px;color:#888;margin-top:2px">211 people like this</div>
                    </div>
                  </div>
                  <div style="position:absolute;left:150px;top:0;width:120px;background:#fff;padding:6px 6px 18px;border-radius:2px;transform:rotate(5deg);box-shadow:0 4px 10px rgba(0,0,0,0.1)">
                    <img src="/images/pencil-workshop.png" alt="Workshop photo" style="display:block;width:100%;height:90px;object-fit:cover">
                    <div style="font-size:9px;color:#999;text-align:center;margin-top:6px">IMG_3021.jpg</div>
                  </div>
                  <div style="position:absolute;left:250px;top:70px;width:170px;background:#efe7d3;border:1px solid #d9cfae;border-radius:3px;padding:12px;transform:rotate(-2deg);box-shadow:0 3px 8px rgba(0,0,0,0.08);font-family:'Courier New',monospace">
                    <div style="font-size:10.5px;font-weight:700;color:#3a3020;letter-spacing:0.03em">PENCIL DESIGN</div>
                    <div style="font-size:8.5px;color:#5a5040;margin-top:3px">CONSTRUCTION &amp; JOINERY</div>
                    <div style="font-size:8.5px;color:#5a5040;margin-top:8px">020 8016 4163</div>
                    <div style="font-size:8.5px;color:#5a5040">South East London</div>
                  </div>
                </div>
              </div>

              <div class="wd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:19px;line-height:1.3;color:#8a6d3f;transform:rotate(-1.5deg);padding-top:10px">Nothing to prepare, bring what's on your phone.</div>
            </div>

            <!-- Day 2 -->
            <div class="wd-row">
              <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 2</div>
              <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

              <div>
                <div style="font-weight:600;font-size:14.5px;margin-bottom:12px;color:#1a1a18">You point at what you like.</div>
                <div class="wd-preference-grid" style="display:grid;grid-template-columns:repeat(3,124px);gap:14px 12px;max-width:440px">

