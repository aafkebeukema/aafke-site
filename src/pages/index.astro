---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/services';
import { tradesForService } from '../data/trades';
import '../styles/page.css';
---

<Layout
  title="Aafke Beukema | AI automations and websites"
  description="I build custom AI automations and websites for small businesses. Practical tools that save you time, from £150 per project."
>
  <main>
    <header class="masthead">
      <h1>I build small tools that give your business back hours every week.</h1>
      <p class="tagline">
        Custom AI automations and websites for people running a business without
        a technical team behind them. Scope and price agreed together, up front.
      </p>
    </header>

    <section aria-labelledby="services">
      <h2 id="services">What I do</h2>
      <div class="services">
        {services.map((service) => (
          <article>
            <h3><a href={service.href}>{service.name}</a></h3>
            <p class="price">{service.price}</p>
            <p>{service.blurb}</p>
            <ul class="trades">
              {tradesForService(service.id).map((trade) => (
                <li>{trade.name}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="about">
      <h2 id="about">Why me</h2>
      <p>
        I previously worked on digital products at Citymapper and Monzo. Now I
        work directly with small businesses.
      </p>
      <p class="spaced">
        <a href="/about">More about me</a>
      </p>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Get in touch</h2>
      <p>
        Tell me what's taking up your time and I'll tell you whether I can help.
        No charge for that conversation.
      </p>
      <p class="spaced">
        <a class="cta" href="mailto:hello@aafke.co.uk">hello@aafke.co.uk</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .trades {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .trades li {
    padding: 0.375rem 0;
    border-top: 1px solid var(--rule);
  }

  h3 a {
    border-bottom: none;
  }

  h3 a:hover {
    border-bottom: 1px solid var(--accent);
  }
</style>
