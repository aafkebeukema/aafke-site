---
import Layout from '../layouts/Layout.astro';
import '../styles/page.css';
---

<Layout
  title="About | Aafke Beukema"
  description="I'm Aafke. I previously worked on digital products at Citymapper and Monzo, and now work directly with small businesses on AI automations and websites."
>
  <main>
    <div class="about-top">
      <img
        class="portrait"
        src="/images/aafke-portrait.webp"
        alt="Portrait of Aafke Beukema."
        width="835"
        height="870"
      />
      <div class="about-text">
        <h1>About me</h1>
        <p class="tagline">Hi, I'm Aafke.</p>

        <section aria-labelledby="story">
          <h2 id="story" class="visually-hidden">My background</h2>
          <p>
            I'm Dutch, and I've lived in London for most of my adult life. I've
            always been drawn to practical problems: everyday things that are
            more confusing, repetitive or frustrating than they need to be.
          </p>
          <p class="spaced">
            I previously worked on digital products at Citymapper and Monzo. Now
            I work directly with small businesses, creating useful AI
            automations and carefully designed websites.
          </p>
          <p class="spaced">
            I like listening closely, working out what the real problem is, and
            making something that feels clear and manageable. Whether it's an
            automation or a website, I want people to understand what I've built
            and feel that it genuinely belongs to them.
          </p>
        </section>
      </div>
    </div>

    <section aria-labelledby="contact" class="contact">
      <h2 id="contact">Get in touch</h2>
      <p>
        Tell me what's taking up your time and I'll tell you whether I can help.
        No charge for that conversation.
      </p>
      <p class="spaced">
        <a class="cta" href="mailto:hello@aafke.co.uk">hello@aafke.co.uk</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .portrait {
    display: block;
    width: 280px;
    max-width: 70%;
    height: auto;
    border-radius: 6px;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: clamp(1.9rem, 5.5vw, 2.6rem);
    text-wrap: balance;
  }

  .tagline {
    margin: 1.5rem 0 0;
    font-size: 1.1875rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .about-text section {
    margin: 2rem 0 0;
  }

  .contact {
    margin-top: 4rem;
  }

  /* The heading exists for structure; the page already says "About me". */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Portrait is first in the DOM so it stacks above the text on a phone.
     On desktop it moves to the right column and the whole of the copy runs
     down the left, so nothing has to wait for the image to end. */
  @media (min-width: 48rem) {
    main {
      max-width: 52rem;
    }

    .about-top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 2.5rem;
      align-items: start;
    }

    .portrait {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      margin-bottom: 0;
    }

    .about-text {
      grid-column: 1;
      grid-row: 1;
    }

    /* Keep the standalone sections at a reading width rather than letting
       them run the full width of the widened page. */
    .contact {
      max-width: var(--measure);
    }
  }
</style>
