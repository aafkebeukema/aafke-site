---
import type { TimelineStep } from '../../data/client-landing-types';
import CalendarMockup from './CalendarMockup.astro';
import ChatMockup from './ChatMockup.astro';
import DraftMessageMockup from './DraftMessageMockup.astro';

interface Props {
  steps: TimelineStep[];
}

const { steps } = Astro.props;
---

<div class="timeline">
  {steps.map((step) => (
    <div class="row">
      <div class="time">{step.time}</div>
      <div class="line"><div class="dot"></div></div>
      <div class="mock">
        {step.demo.type === 'chat' && <ChatMockup demo={step.demo} />}
        {step.demo.type === 'calendar' && <CalendarMockup demo={step.demo} />}
        {step.demo.type === 'draft' && <DraftMessageMockup demo={step.demo} />}
      </div>
      <div class="note">{step.note}</div>
    </div>
  ))}
</div>

<style>
  .row { display: grid; grid-template-columns: 70px 18px minmax(0, 1fr) 220px; gap: 22px; padding: 36px 0; }
  .line { position: relative; display: flex; justify-content: center; }
  .line::before { content: ''; position: absolute; inset: 0 auto -36px 50%; width: 1px; background: oklch(0.8 0.01 90); transform: translateX(-50%); }
  .row:last-of-type .line::before { bottom: 50%; }
  .time { font-family: 'Newsreader', Georgia, serif; font-weight: 600; font-size: 15px; padding-top: 14px; text-align: right; color: #1a1a18; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: oklch(0.42 0.14 258); margin-top: 18px; z-index: 1; }
  .note { align-self: center; font-family: 'Caveat', cursive; font-size: 19px; line-height: 1.3; color: oklch(0.42 0.14 258); padding-top: 10px; }
  .mock { min-width: 0; }
  @media (max-width: 900px) {
    .row { grid-template-columns: 70px 18px minmax(0, 1fr); }
    .note { grid-column: 3; }
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 8px; }
    .line { display: none; }
    .time { text-align: left; padding-top: 0; }
    .note { grid-column: 1; margin-top: 4px; padding-top: 0; }
  }
</style>
