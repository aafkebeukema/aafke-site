---
import { services } from '../data/services';
import { menuForService } from '../data/projects';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  ...services.map((service) => ({
    href: service.href,
    label: service.navLabel,
    id: service.id,
    menu: menuForService(service.id, service.href),
  })),
  { href: '/about', label: 'About', id: 'about', menu: [] as { href: string; label: string }[] },
];

// A submenu of one is just the overview again, so it earns nothing.
const withMenu = (menu: { href: string }[]) => menu.length > 1;
const isCurrent = (href: string) => path === href;
const inSection = (menu: { href: string }[]) => menu.some((item) => isCurrent(item.href));
---

<nav aria-label="Main">
  <a class="wordmark" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
    Aafke Beukema
  </a>

  <ul class="top">
    {links.map((link) =>
      withMenu(link.menu) ? (
        <li class="top-item has-menu" data-menu-item>
          <button
            type="button"
            class:list={['control', { active: inSection(link.menu) }]}
            aria-expanded="false"
            aria-controls={`menu-${link.id}`}
            data-menu-toggle
          >
            {link.label}
            <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false">
              <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </button>

          <ul class="submenu" id={`menu-${link.id}`} hidden>
            {link.menu.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li class="top-item">
          <a
            class="control"
            href={link.href}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ),
    )}
  </ul>
</nav>

<script>
  const CLOSE_DELAY = 250;
  // Hover is an enhancement for real pointers only; touch uses tap.
  const pointerHovers = window.matchMedia('(hover: hover) and (pointer: fine)');

  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-menu-item]'));

  // A pointer press focuses the control before the click lands. Without this
  // flag, focusin would open the menu and the click would immediately toggle
  // it shut, so a tap would appear to do nothing.
  let pointerPressed = false;
  document.addEventListener(
    'pointerdown',
    () => {
      pointerPressed = true;
      window.setTimeout(() => {
        pointerPressed = false;
      }, 0);
    },
    true,
  );

  interface Menu {
    item: HTMLElement;
    toggle: HTMLButtonElement;
    panel: HTMLElement;
    timer: number | undefined;
    /** Committed open by a click or key, rather than transiently by hover. */
    pinned: boolean;
  }

  const menus: Menu[] = items.flatMap((item) => {
    const toggle = item.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const id = toggle?.getAttribute('aria-controls');
    const panel = id ? document.getElementById(id) : null;
    return toggle && panel ? [{ item, toggle, panel, timer: undefined, pinned: false }] : [];
  });

  function setOpen(menu: Menu, open: boolean) {
    window.clearTimeout(menu.timer);
    menu.toggle.setAttribute('aria-expanded', String(open));
    menu.panel.hidden = !open;
    if (!open) menu.pinned = false;
  }

  const isOpen = (menu: Menu) => menu.toggle.getAttribute('aria-expanded') === 'true';

  function closeOthers(except: Menu) {
    menus.forEach((menu) => menu !== except && setOpen(menu, false));
  }

  /** Delayed so the pointer can cross the gap between control and panel. */
  function closeSoon(menu: Menu) {
    window.clearTimeout(menu.timer);
    menu.timer = window.setTimeout(() => setOpen(menu, false), CLOSE_DELAY);
  }

  menus.forEach((menu) => {
    // Hover may already have opened it, so the first click commits it open
    // rather than closing it. The next click closes.
    menu.toggle.addEventListener('click', () => {
      closeOthers(menu);
      if (isOpen(menu) && menu.pinned) {
        setOpen(menu, false);
        return;
      }
      setOpen(menu, true);
      menu.pinned = true;
    });

    // Pointer. The listeners sit on the whole item, so moving between the
    // control and the panel never leaves it.
    menu.item.addEventListener('mouseenter', () => {
      if (!pointerHovers.matches) return;
      closeOthers(menu);
      setOpen(menu, true);
    });

    menu.item.addEventListener('mouseleave', () => {
      if (!pointerHovers.matches || menu.pinned) return;
      closeSoon(menu);
    });

    // Keyboard focus opens it. Pointer focus does not, because the click
    // that follows is what toggles it.
    menu.item.addEventListener('focusin', () => {
      if (pointerPressed) return;
      closeOthers(menu);
      setOpen(menu, true);
    });

    menu.item.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (next && menu.item.contains(next)) return;
      setOpen(menu, false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = menus.find(isOpen);
    if (!open) return;
    setOpen(open, false);
    open.toggle.focus();
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    menus.forEach((menu) => {
      if (!menu.item.contains(target)) setOpen(menu, false);
    });
  });
</script>

<style>
  nav {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
  }

  .wordmark {
    font-weight: 600;
    letter-spacing: -0.01em;
    border-bottom: none;
    margin-right: auto;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .top-item {
    position: relative;
  }

  /* One control for the label and the caret, whether button or link. */
  .control {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0;
    border: none;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }

  .control:hover,
  .control:focus-visible {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .control.active,
  .control[aria-current='page'] {
    color: var(--ink);
  }

  .control[aria-current='page'] {
    border-bottom-color: var(--rule);
  }

  .control svg {
    width: 0.625rem;
    height: 0.375rem;
    transition: transform 0.15s ease;
  }

  .control[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 0;
    z-index: 10;
    min-width: max-content;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* An invisible bridge across the gap, so hover survives the crossing. */
  .submenu::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -0.75rem;
    height: 0.75rem;
  }

  .submenu[hidden] {
    display: none;
  }

  .submenu a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 4px;
    border-bottom: none;
    white-space: nowrap;
    color: var(--muted);
  }

  .submenu a:hover,
  .submenu a:focus-visible,
  .submenu a[aria-current='page'] {
    background: var(--rule);
    color: var(--ink);
    border-bottom: none;
  }

  /* Mobile: stacked rows with a nested menu inline, never a floating panel. */
  @media (max-width: 34rem) {
    nav {
      display: block;
      padding-bottom: 0.5rem;
    }

    .wordmark {
      display: block;
      margin-bottom: 0.25rem;
    }

    .top {
      display: block;
      font-size: 1rem;
    }

    .top-item {
      position: static;
      border-top: 1px solid var(--rule);
    }

    .control {
      display: flex;
      width: 100%;
      min-height: 44px;
      justify-content: space-between;
      border-bottom: none;
      text-align: left;
    }

    .control:hover,
    .control:focus-visible {
      border-bottom-color: transparent;
    }

    .control svg {
      width: 0.75rem;
      height: 0.5rem;
    }

    .submenu {
      position: static;
      min-width: 0;
      padding: 0 0 0.5rem 1rem;
      border: none;
      border-radius: 0;
      box-shadow: none;
      background: transparent;
      gap: 0;
    }

    .submenu::before {
      display: none;
    }

    .submenu a {
      display: flex;
      align-items: center;
      min-height: 44px;
      white-space: normal;
      padding: 0.25rem 0.5rem;
    }
  }
</style>
