---
import { services } from '../data/services';
import { menuForService } from '../data/projects';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  ...services.map((service) => ({
    href: service.href,
    label: service.navLabel,
    id: service.id,
    menu: menuForService(service.id, service.href),
  })),
  { href: '/about', label: 'About', id: 'about', menu: [] },
];

// A submenu of one is just the overview again, so it earns nothing.
const withMenu = (menu: { href: string }[]) => menu.length > 1;
const isCurrent = (href: string) => path === href;
const inSection = (menu: { href: string }[]) => menu.some((item) => isCurrent(item.href));
---

<nav aria-label="Main">
  <a class="wordmark" href="/" aria-current={isCurrent('/') ? 'page' : undefined}>
    Aafke Beukema
  </a>
  <ul class="top">
    {links.map((link) => (
      <li class:list={['top-item', { 'has-menu': withMenu(link.menu) }]}>
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? 'page' : undefined}
          class:list={{ 'in-section': inSection(link.menu) && !isCurrent(link.href) }}
        >
          {link.label}
        </a>

        {withMenu(link.menu) && (
          <>
            <button
              type="button"
              class="disclosure"
              aria-expanded="false"
              aria-controls={`menu-${link.id}`}
              data-menu-toggle
            >
              <span class="visually-hidden">{`Show ${link.label} pages`}</span>
              <svg viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
            <ul class="submenu" id={`menu-${link.id}`} hidden>
              {link.menu.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </li>
    ))}
  </ul>
</nav>

<script>
  const toggles = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]'),
  );

  function submenuFor(toggle: HTMLButtonElement): HTMLElement | null {
    const id = toggle.getAttribute('aria-controls');
    return id ? document.getElementById(id) : null;
  }

  function close(toggle: HTMLButtonElement) {
    toggle.setAttribute('aria-expanded', 'false');
    const menu = submenuFor(toggle);
    if (menu) menu.hidden = true;
  }

  function closeAll(except?: HTMLButtonElement) {
    toggles.forEach((toggle) => {
      if (toggle !== except) close(toggle);
    });
  }

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      closeAll(toggle);
      toggle.setAttribute('aria-expanded', String(!open));
      const menu = submenuFor(toggle);
      if (menu) menu.hidden = open;
    });
  });

  // Escape closes and returns focus to the button that opened the menu.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = toggles.find((t) => t.getAttribute('aria-expanded') === 'true');
    if (!open) return;
    close(open);
    open.focus();
  });

  // A click or tap outside any menu closes them.
  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    const inside = toggles.some((toggle) => toggle.closest('.top-item')?.contains(target));
    if (!inside) closeAll();
  });

  // Tabbing out of a menu closes it, so keyboard order stays predictable.
  document.addEventListener('focusin', (event) => {
    const target = event.target as Node;
    toggles.forEach((toggle) => {
      const item = toggle.closest('.top-item');
      if (item && !item.contains(target)) close(toggle);
    });
  });
</script>

<style>
  nav {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 1.75rem 1.5rem 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.5rem;
  }

  .wordmark {
    font-weight: 600;
    letter-spacing: -0.01em;
    border-bottom: none;
    margin-right: auto;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
  }

  .top-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
  }

  a {
    border-bottom: 1px solid transparent;
    color: var(--muted);
  }

  .wordmark,
  a[aria-current='page'] {
    color: var(--ink);
  }

  a:hover,
  a:focus-visible {
    border-bottom-color: var(--accent);
    color: var(--ink);
  }

  a[aria-current='page'] {
    border-bottom-color: var(--rule);
  }

  a.in-section {
    color: var(--ink);
  }

  .disclosure {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    align-self: center;
  }

  /* Expand the hit area to ~44px without changing how the control looks. */
  .disclosure::before {
    content: '';
    position: absolute;
    inset: -0.625rem;
  }

  .disclosure:hover,
  .disclosure:focus-visible {
    color: var(--ink);
    background: var(--rule);
  }

  .disclosure svg {
    width: 0.625rem;
    height: 0.375rem;
    transition: transform 0.15s ease;
  }

  .disclosure[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .submenu {
    position: absolute;
    top: calc(100% + 0.625rem);
    left: 0;
    z-index: 10;
    min-width: max-content;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .submenu[hidden] {
    display: none;
  }

  .submenu a {
    display: block;
    padding: 0.375rem 0.625rem;
    border-radius: 4px;
    border-bottom: none;
    white-space: nowrap;
  }

  .submenu a:hover,
  .submenu a:focus-visible {
    background: var(--rule);
    border-bottom: none;
    color: var(--ink);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* On a phone the panel must stay anchored to its item, so cap its width
     rather than changing how it is positioned. */
  @media (max-width: 34rem) {
    .submenu {
      min-width: 0;
      width: max-content;
      max-width: calc(100vw - 3rem);
    }

    .submenu a {
      white-space: normal;
    }
  }
</style>
