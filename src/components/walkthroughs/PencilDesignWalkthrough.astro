---
import '../../styles/walkthrough.css';
---

<div class="case-bleed">
    <section class="case-panel" id="panel-websites">
      <div class="case-inner">
        <header style="max-width:680px;margin-bottom:48px">
          <h3 style="font-family:'Newsreader',Georgia,serif;font-size:clamp(30px,4vw,42px);line-height:1.15;margin:0 0 18px;font-weight:600">A fortnight with Pencil Design</h3>
          <p style="font-size:19px;line-height:1.55;color:#6b6b66;margin:0;font-style:italic;font-family:'Newsreader',Georgia,serif">No brief to write, no jargon to learn, just your business as it already is, turned into a site that looks like you.</p>
        </header>

        <div>

          <!-- Day 1 -->
          <div class="wd-row">
            <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 1</div>
            <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

            <div>
              <div style="font-weight:600;font-size:14.5px;margin-bottom:12px;color:#1a1a18">You show me what you've got.</div>
              <div class="wd-collage" style="position:relative;height:200px;max-width:440px">
                <div style="position:absolute;left:0;top:6px;width:190px;background:#fff;border:1px solid #d8d5cd;border-radius:6px;overflow:hidden;transform:rotate(-3deg);box-shadow:0 3px 8px rgba(0,0,0,0.08);font-family:system-ui,sans-serif">
                  <div style="background:#3b5998;color:#fff;font-size:10px;font-weight:700;padding:5px 8px">facebook</div>
                  <div style="height:44px;background:#c9c2b3"></div>
                  <div style="padding:8px">
                    <div style="font-size:11px;font-weight:700;color:#222">Pencil Design</div>
                    <div style="font-size:9.5px;color:#888;margin-top:2px">211 people like this</div>
                  </div>
                </div>
                <div style="position:absolute;left:150px;top:0;width:120px;background:#fff;padding:6px 6px 18px;border-radius:2px;transform:rotate(5deg);box-shadow:0 4px 10px rgba(0,0,0,0.1)">
                  <img src="/images/pencil-workshop.png" alt="Workshop photo" style="display:block;width:100%;height:90px;object-fit:cover">
                  <div style="font-size:9px;color:#999;text-align:center;margin-top:6px">IMG_3021.jpg</div>
                </div>
                <div style="position:absolute;left:250px;top:70px;width:170px;background:#efe7d3;border:1px solid #d9cfae;border-radius:3px;padding:12px;transform:rotate(-2deg);box-shadow:0 3px 8px rgba(0,0,0,0.08);font-family:'Courier New',monospace">
                  <div style="font-size:10.5px;font-weight:700;color:#3a3020;letter-spacing:0.03em">PENCIL DESIGN</div>
                  <div style="font-size:8.5px;color:#5a5040;margin-top:3px">CONSTRUCTION &amp; JOINERY</div>
                  <div style="font-size:8.5px;color:#5a5040;margin-top:8px">020 8016 4163</div>
                  <div style="font-size:8.5px;color:#5a5040">South East London</div>
                </div>
              </div>
            </div>

            <div class="wd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:19px;line-height:1.3;color:#8a6d3f;transform:rotate(-1.5deg);padding-top:10px">Nothing to prepare, bring what's on your phone.</div>
          </div>

          <!-- Day 2 -->
          <div class="wd-row">
            <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 2</div>
            <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

            <div>
              <div style="font-weight:600;font-size:14.5px;margin-bottom:12px;color:#1a1a18">You point at what you like.</div>
              <div class="wd-preference-grid" style="display:grid;grid-template-columns:repeat(3,124px);gap:14px 12px;max-width:440px">

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#fff;border:1px solid #ddd9cd;overflow:hidden">
                    <div style="height:11px;background:#f1efe8;border-bottom:1px solid #ddd9cd;display:flex;align-items:center;padding-left:5px;font-size:6px;color:#999;font-family:system-ui,sans-serif">storeyarchitecture.co.uk</div>
                    <div style="height:67px;position:relative;overflow:hidden;background:#0a0a0a">
                      <div style="position:absolute;top:6px;left:10px;width:20px;height:12px;background:#5a5a5a;transform:rotate(-30deg)"></div>
                      <div style="position:absolute;top:2px;left:44px;width:14px;height:10px;background:#666;transform:rotate(15deg)"></div>
                      <div style="position:absolute;top:10px;left:66px;width:18px;height:12px;background:#5a5a5a;transform:rotate(25deg)"></div>
                      <div style="position:absolute;bottom:14px;right:5px;width:36px;height:34px;background:#efedea;padding:2px">
                        <div style="width:100%;height:24px;background:#111"></div>
                        <div style="font-size:3.6px;color:#1a1a18;text-align:center;margin-top:2px;letter-spacing:0.02em;font-family:system-ui,sans-serif;border-top:0.5px solid #1a1a18;padding-top:1px">HOVER + VISIT</div>
                      </div>
                      <div style="position:absolute;bottom:2px;left:5px;font-size:4px;color:#ddd;letter-spacing:0.02em;font-family:system-ui,sans-serif">HOVER + CLICK TO VISIT PROJECTS</div>
                    </div>
                  </div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#4a7a52;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">A cool, tight design that's not too busy?</div>
                </div>

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#f6f3ec;border:1px solid #e6e1d2;padding:8px;font-family:'Newsreader',Georgia,serif;font-style:italic;font-size:9.5px;line-height:1.35;color:#4a453a">"Want people to see we do full renovations, not just kitchens now."</div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#4a7a52;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">In their words</div>
                </div>

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#fff;border:1px solid #ddd9cd;overflow:hidden">
                    <div style="height:11px;background:#f1efe8;border-bottom:1px solid #ddd9cd;display:flex;align-items:center;padding-left:5px;font-size:6px;color:#999;font-family:system-ui,sans-serif">timpiacademy.co.uk/about</div>
                    <div style="height:67px;padding:6px;display:flex;gap:5px;align-items:center;background:#fff">
                      <div style="width:22px;height:48px;border-radius:50%;background:linear-gradient(160deg,#8a9560,#3a2e22 75%);flex:none"></div>
                      <div style="flex:1">
                        <div style="font-family:'Newsreader',Georgia,serif;font-size:8.5px;color:#8a9560;margin-bottom:3px">About me</div>
                        <div style="height:2.5px;width:90%;background:#222;margin-bottom:2px"></div>
                        <div style="height:2.5px;width:82%;background:#222;margin-bottom:2px"></div>
                        <div style="height:2.5px;width:55%;background:#ccc"></div>
                      </div>
                    </div>
                  </div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#4a7a52;color:#fff;font-size:11px;display:flex;align-items:center;justify-content:center">✓</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">An approachable about-me section like this?</div>
                </div>

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#fff;border:1px solid #ddd9cd;overflow:hidden;opacity:0.75">
                    <div style="height:14px;background:#eef3f8;border-bottom:1px solid #ddd9cd;display:flex;align-items:center;padding-left:5px;font-size:6.5px;color:#999;font-family:system-ui,sans-serif">buildfasttemplates.com/42</div>
                    <img src="/images/stock-photo-example.png" alt="" style="display:block;width:100%;height:20px;object-fit:cover;margin:5px 6px;width:calc(100% - 12px)">
                    <div style="height:4px;width:80%;background:#dbe6ef;margin:5px 6px"></div>
                    <div style="height:4px;width:80%;background:#dbe6ef;margin:3px 6px"></div>
                  </div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#a34a3f;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center">✕</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">No stock photos</div>
                </div>

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#f6f3ec;border:1px solid #e6e1d2;padding:8px;font-family:'Newsreader',Georgia,serif;font-style:italic;font-size:9.5px;line-height:1.35;color:#4a453a">"Don't need every service on the homepage, just the good projects."</div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#a34a3f;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center">✕</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">In their words</div>
                </div>

                <div style="position:relative">
                  <div style="height:78px;border-radius:3px;background:#2b2b28;border:1px solid #2b2b28;overflow:hidden">
                    <div style="height:14px;background:#eee;border-bottom:1px solid #ddd;display:flex;align-items:center;padding-left:5px;font-size:6.5px;color:#999;font-family:system-ui,sans-serif">buildrightpro.com</div>
                    <div style="height:20px;margin:5px 6px;background:linear-gradient(90deg,#e6392f 0 33%,#f2c40f 33% 66%,#1e5bd6 66% 100%);position:relative"><div style="position:absolute;top:6px;left:4px;width:24px;height:5px;background:#fff"></div></div>
                    <div style="height:4px;width:60%;background:#4a4a46;margin:5px 6px"></div>
                  </div>
                  <div style="position:absolute;top:-6px;right:-6px;width:18px;height:18px;border-radius:50%;background:#a34a3f;color:#fff;font-size:10px;display:flex;align-items:center;justify-content:center">✕</div>
                  <div style="font-size:9px;color:#6b6b66;margin-top:5px;line-height:1.3">No bright primary colours</div>
                </div>

              </div>
            </div>

            <div class="wd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:19px;line-height:1.3;color:#8a6d3f;transform:rotate(1deg);padding-top:10px">No brief to write, just show me what you like and don't.</div>
          </div>

          <!-- Day 5 -->
          <div class="wd-row">
            <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 5</div>
            <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

            <div style="background:#fff;border:1px solid #d8d5cd;border-radius:6px;overflow:hidden;max-width:460px;font-family:system-ui,sans-serif">
              <div style="background:#eeece7;padding:7px 10px;display:flex;align-items:center;gap:6px;border-bottom:1px solid #d8d5cd">
                <div style="width:8px;height:8px;border-radius:50%;background:#d8a45c"></div>
                <div style="width:8px;height:8px;border-radius:50%;background:#c7c2b6"></div>
                <div style="width:8px;height:8px;border-radius:50%;background:#c7c2b6"></div>
                <div style="font-size:10px;color:#888;margin-left:6px">pencil-design.co.uk</div>
              </div>
              <div style="padding:16px 18px">
                <div style="display:flex;gap:14px;font-size:10.5px;color:#6b6b66;margin-bottom:14px">
                  <span>Home</span><span>Projects</span><span>Our Services</span><span>About Us</span><span>Contact</span>
                </div>
                <img src="https://www.pencil-design.co.uk/images/home-hero-main.jpg" alt="Pencil Design homepage hero" style="display:block;width:100%;height:80px;border-radius:3px;margin-bottom:12px;object-fit:cover">
                <div style="font-size:16px;font-weight:600;color:#1a1a18;margin-bottom:6px;line-height:1.3">Not your average construction company.</div>
                <div style="font-size:11.5px;color:#6b6b66;line-height:1.5">Design-led construction and renovation in South East London, from kitchens and wardrobes to full home renovations.</div>
              </div>
            </div>

            <div class="wd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:19px;line-height:1.3;color:#8a6d3f;transform:rotate(-1deg);padding-top:10px">Your business, not a template with your logo dropped in.</div>
          </div>

          <!-- Day 10 -->
          <div class="wd-row" style="padding:44px 0 56px">
            <div style="font-family:'Newsreader',Georgia,serif;font-weight:600;font-size:15px;padding-top:14px;text-align:right;color:#1a1a18">Day 10</div>
            <div class="wd-lineCol"><div style="width:9px;height:9px;border-radius:50%;background:#8a6d3f;margin-top:18px;z-index:1"></div></div>

            <div>
              <div style="font-weight:600;font-size:16px;margin-bottom:14px;color:#1a1a18">You get the keys.</div>
              <div class="wd-keys" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px">
                <div style="background:#fff;border:1px solid #d8d5cd;border-radius:6px;padding:12px;font-family:system-ui,sans-serif">
                  <div style="font-size:10px;font-weight:600;color:#889;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px">Handover files</div>
                  <div style="font-size:11.5px;color:#333;display:flex;flex-direction:column;gap:6px">
                    <div>📁 logo-files/</div>
                    <div>📁 photos/</div>
                    <div>🗎 Website (handover).zip</div>
                  </div>
                </div>
                <div style="background:#fff;border:1px solid #d8d5cd;border-radius:6px;padding:12px;font-family:system-ui,sans-serif">
                  <div style="font-size:10px;font-weight:600;color:#889;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px">pencil-design.co.uk</div>
                  <div style="font-size:10.5px;color:#666;margin-bottom:4px">Username</div>
                  <div style="background:#f4f2ec;border:1px solid #e0ddd4;border-radius:4px;padding:5px 7px;font-size:10.5px;color:#333;margin-bottom:8px">contact@pencil-design.co.uk</div>
                  <div style="font-size:10.5px;color:#666;margin-bottom:4px">Password</div>
                  <div style="background:#f4f2ec;border:1px solid #e0ddd4;border-radius:4px;padding:5px 7px;font-size:10.5px;color:#333;margin-bottom:10px">••••••••••</div>
                  <div style="background:#1a1a18;color:#fff;border-radius:4px;padding:6px;font-size:10.5px;text-align:center;font-weight:600">Log in</div>
                </div>
                <div style="background:#fff;border:1px solid #d8d5cd;border-radius:6px;padding:12px;font-family:system-ui,sans-serif">
                  <div style="font-size:10px;font-weight:600;color:#889;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:8px">Site visit hours</div>
                  <div style="font-size:10.5px;color:#333;display:flex;flex-direction:column;gap:4px;margin-bottom:10px">
                    <div style="display:flex;justify-content:space-between"><span>Mon-Fri</span><span>8am-5pm</span></div>
                    <div style="display:flex;justify-content:space-between"><span>Sat</span><span>By appointment</span></div>
                    <div style="display:flex;justify-content:space-between"><span>Sun</span><span>Closed</span></div>
                  </div>
                  <div style="background:#eeece7;color:#1a1a18;border:1px solid #d8d5cd;border-radius:4px;padding:6px;font-size:10.5px;text-align:center;font-weight:600">Save changes</div>
                </div>
              </div>
            </div>

            <div class="wd-note" style="align-self:center;font-family:'Caveat',cursive;font-size:19px;line-height:1.3;color:#8a6d3f;transform:rotate(1.5deg);padding-top:10px">It's yours. Change it yourself, or ask me.</div>
          </div>

        </div>

        <footer style="max-width:640px;margin-top:8px;border-top:1px solid #e4e2dd;padding-top:28px">
          <p style="font-family:'Newsreader',Georgia,serif;font-size:18px;line-height:1.5;color:#1a1a18;margin:0;font-style:italic">Ten days from a phone full of photos to a site that's yours outright, no subscription, no page-builder lock-in, this is the real site now live at <a href="https://www.pencil-design.co.uk" style="color:inherit">pencil-design.co.uk</a>.</p>
        </footer>
      </div>
    </section>
</div>
